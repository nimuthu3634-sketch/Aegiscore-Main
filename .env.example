# =========================
# Database
# =========================
POSTGRES_DB=aegiscore
POSTGRES_USER=aegiscore
POSTGRES_PASSWORD=aegiscore_dev_password
POSTGRES_PORT=5432

# =========================
# Application Ports
# =========================
API_PORT=8000
WEB_PORT=5173
NGINX_PORT=80

# =========================
# Authentication
# =========================
JWT_SECRET_KEY=replace-with-a-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# Default Seed Users
# =========================
DEV_SEED_ADMIN_USERNAME=admin
DEV_SEED_ADMIN_PASSWORD=AegisCore123!
DEV_SEED_ANALYST_USERNAME=analyst
DEV_SEED_ANALYST_PASSWORD=AegisCore123!

# =========================
# Frontend
# =========================
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://api:8000
VITE_ENABLE_DEV_AUTH_BOOTSTRAP=false

# =========================
# Wazuh Manager API
# Used for agent online/offline status
# Port: 55000
# =========================
WAZUH_BASE_URL=https://host.docker.internal:55000
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=PASTE_WAZUH_API_PASSWORD_HERE
WAZUH_VERIFY_TLS=false

# =========================
# Wazuh Indexer API
# Used for alerts from wazuh-alerts-*
# Port: 9200
# =========================
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=PASTE_INDEXER_ADMIN_PASSWORD_HERE
WAZUH_INDEXER_ALERT_INDEX=wazuh-alerts-*
WAZUH_INDEXER_VERIFY_TLS=false

# =========================
# Suricata
# =========================
SURICATA_SOURCE=suricata

# =========================
# AI Scoring
# baseline = fallback rule-based scoring
# model = TensorFlow alert prioritization model
# =========================
SCORING_STRATEGY=model
SCORING_BASELINE_VERSION=baseline_v1
SCORING_MODEL_PATH=/srv/ai/models/aegiscore-risk-priority-model.keras
SCORING_MODEL_METADATA_PATH=/srv/ai/models/aegiscore-risk-priority-model.metadata.json
SCORING_MODEL_VERSION=enterprise_model_v1

# =========================
# Automated Response
# ledger = safe mode, records action without firewall changes
# =========================
AUTOMATED_RESPONSE_ML_BRUTE_FORCE_ENABLED=true
AI_DIRECT_BRUTE_FORCE_BLOCK_ENABLED=true
AUTOMATED_RESPONSE_BLOCK_IP_BACKEND=ledger
AUTOMATED_RESPONSE_BUILTIN_ADAPTERS_ENABLED=true
AUTOMATED_RESPONSE_ALLOW_DESTRUCTIVE=false
AUTOMATED_RESPONSE_LAB_ADAPTERS_ENABLED=false
AUTOMATED_RESPONSE_MAX_RETRIES=1

RESPONSE_ADAPTER_BLOCK_IP_SCRIPT=
RESPONSE_ADAPTER_DISABLE_USER_SCRIPT=
RESPONSE_ADAPTER_QUARANTINE_HOST_FLAG_SCRIPT=
RESPONSE_ADAPTER_CREATE_MANUAL_REVIEW_SCRIPT=
RESPONSE_ADAPTER_NOTIFY_ADMIN_SCRIPT=

# =========================
# Notifications
# =========================
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_MODE=log
NOTIFICATIONS_RISK_THRESHOLD=85
NOTIFICATIONS_INCIDENT_STATES=triaged,investigating,contained
NOTIFICATIONS_RESPONSE_STATUSES=warning,failed
NOTIFICATIONS_RESPONSE_ACTION_TYPES=*
NOTIFICATIONS_ADMIN_RECIPIENTS=admin@aegiscore.local
NOTIFICATIONS_SENDER=aegiscore@localhost